# lark-twin 配置(全部有默认值,按需修改)
# 复制为 .env 放在项目根目录即可生效

# 区域: feishu(飞书国内版) | lark(Lark 国际版 larksuite.com)
# 只决定首次登录走哪边;登录后以凭证里记录的区域为准,切换用 larkx auth qr --region <feishu|lark>
LARKX_REGION=feishu

# 数据目录(凭证/消息库/数字人目录/agent 会话记录)
LARKX_HOME=~/.larkx

# 消息存储: 留空 = SQLite(自动存到 LARKX_HOME/messages.db)
# 用 MySQL 则填: mysql+pymysql://<user>:<password>@<host>:3306/<db>
LARKX_STORAGE_URL=

# 收到消息自动标记已读(默认开;手机端未读角标会清掉)
LARKX_MARK_READ=true

# ---- 数字人(larkx daemon) ----

# 用哪种 coding agent 驱动数字人: claude(Claude Code,一直开着的会话) | codex(每轮 codex exec resume 接着同一个会话)
LARKX_AGENT_BACKEND=claude

# 数字人工作目录: CLAUDE.md(人设和行为准则)、skill 都在这里。留空 = LARKX_HOME/agent
# 首次启动时从模板生成 CLAUDE.md,之后不会覆盖,可以直接改
LARKX_AGENT_HOME=

# 数字人专用的 Claude Code 配置目录(会话记录在这里)。留空 = LARKX_HOME/claude
LARKX_AGENT_CLAUDE_DIR=

# 数字人专用的 CODEX_HOME(codex 后端)。认证软链到你自己的 ~/.codex/auth.json。留空 = LARKX_HOME/codex
LARKX_AGENT_CODEX_DIR=

# 启动 agent 的命令: 填你平时启动 coding agent 的方式, 认证沿用你自己的配置。
# claude 后端: 如 claude, 或 ccd 这类启动器; 留空则用 Agent SDK 自带的 claude, 认证取下面两个变量(或当前环境里的同名变量)
LARKX_CLAUDE_CLI=
# codex 后端: 默认 codex, 认证沿用你自己的 codex login
LARKX_CODEX_CLI=codex
# 写了 key 记得 chmod 600 .env
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=

# 模型。留空用 Claude Code 默认(用启动器时由启动器决定)
LARKX_AGENT_MODEL=

# 备用模型: 主模型被安全策略拦截时,Claude Code 会把整个会话切到备用模型。
# 必须填当前接入点可用的模型,否则一次误判就会让常驻会话每一轮都失败
LARKX_AGENT_FALLBACK_MODEL=

# 单轮处理超时(秒),超时后中断这一轮
LARKX_AGENT_TURN_TIMEOUT=1800

# agent 需要代理时写在这里(.env 里的变量会传给 agent)。注意 Codex 读的是大写变量
# HTTPS_PROXY=
# HTTP_PROXY=

# 长期记忆: 每天几点(本地时间)回顾当天的对话并整理记忆, -1 关闭
LARKX_MEMORY_REVIEW_HOUR=4
# 上下文用到自动压缩阈值的这个比例时, 先整理记忆再压缩(claude 后端)
LARKX_MEMORY_FLUSH_RATIO=0.85

# 数字人发出的每条消息(包括 /stop、/clear 的回执)末尾另起一行加上的签名, 如: 🤖 lark-twin · 数字分身。留空不加
LARKX_REPLY_SIGNATURE=

# ---- 通知与告警(发到你和自己的私聊) ----

# 数字人在别的会话以你的名义发消息时, 抄送一份给你
LARKX_MIRROR=true
# 通知发往的会话; 留空 = 你和自己的私聊
LARKX_NOTIFY_CHAT=
# 你的账号用不了(如飞书登录失效)时的备用通知命令, {text} 会替换成通知内容。例: 用官方 lark-cli 的机器人身份
# LARKX_ALERT_CMD=lark-cli im +messages-send --as bot --user-id ou_xxx --text {text}
LARKX_ALERT_CMD=
# 数字人 10 分钟内最多发多少条消息, 超过就拦下并告警
LARKX_SEND_RATE_LIMIT=20

# ---- 可靠性 ----

# 重启后补处理的触发消息最多是多久之前的(秒), 更早的不再回复
LARKX_INBOX_MAX_AGE=7200
# 每隔多久核对一次最近活跃的会话有没有漏收消息(秒), 0 关闭
LARKX_CATCHUP_INTERVAL=900

# ---- 触发规则: 哪些消息交给数字人 ----

# 触发前缀: 只处理以此前缀开头的消息(留空 = 全部处理)
LARKX_TRIGGER_PREFIX=/ai

# 本人发的 /ai 消息也交给数字人(默认开): 给它下指令、/stop、/clear、/takeover 都靠这个
# 没有触发前缀时本人的消息一律不触发; 数字人的回复也被禁止以前缀开头, 不会自己触发自己
LARKX_ALLOW_SELF=true

# 群聊里是否还必须 @我(私聊不受影响)
# LARKX_TRIGGER_GROUP_AT_ONLY=true

# 只在这些会话类型触发: p2p(私聊) / group(群) / topic_group(话题群),逗号分隔
# LARKX_TRIGGER_CHAT_TYPES=p2p

# 白名单 / 黑名单: 指定群 chat_id、指定发送人 user_id(逗号分隔)
# LARKX_TRIGGER_INCLUDE_CHATS=
# LARKX_TRIGGER_EXCLUDE_CHATS=
# LARKX_TRIGGER_INCLUDE_SENDERS=

# 关键词(消息需包含其一;前缀已满足时一般不用)
# LARKX_TRIGGER_KEYWORDS=

# 登录凭证不放这里,用命令管理:
#   larkx auth qr                            扫码登录(推荐)
#   larkx auth import --cookie "<cookie>"    手动导入
